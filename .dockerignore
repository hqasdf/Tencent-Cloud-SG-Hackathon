!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!frontend/Dockerfile
!deploy/
!deploy/Caddyfile
**/__pycache__/**
**/*.pyc
**/.env*
**/*.db
**/*.sqlite3
**/*.log
**/credentials*.json
**/service-account*.json
**/*.pem
**/*.key
