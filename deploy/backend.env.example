# Copy to the ignored backend.env on the deployment host. No credentials here.
# Offline demo mode does not call Gemini. Mock transport retains its 1024 ceiling;
# the approved live Gemini configuration below retains 4096.
AGENT_MODE=mock
AGENT_PROVIDER=mock
AGENT_MAX_TOKENS=1024
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_RETRIES=1
AGENT_RETRY_BACKOFF_SECONDS=1
AGENT_RETRY_MAX_BACKOFF_SECONDS=20
AGENT_REASONING_EFFORT=low
# Same-origin routing needs no cross-origin permission.
CORS_ALLOWED_ORIGINS=
REPLAY_API_ENABLED=1
REPLAY_ARTIFACT_DIR=/data/replay/submission-v1

# Enable only after separately approved live configuration/validation.
# AGENT_MODE=real
# AGENT_PROVIDER=gemini_native
# AGENT_MODEL=gemini-3.8-flash
# AGENT_MAX_TOKENS=4096
AGENT_API_KEY=
