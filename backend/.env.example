# RydeResolve agent configuration.
#
# Copy this file to `.env` and adjust. The defaults below require NO credentials and
# run entirely offline, which is why `mock` is the default mode.

# ---------------------------------------------------------------------------
# Mode: "mock" or "real"
# ---------------------------------------------------------------------------
# mock  - deterministic, offline, no credentials. Used by the default setup and by
#         the entire test suite. Output is derived from the trusted case context,
#         so it stays realistic while remaining fully reproducible.
# real  - calls an external model. Requires AGENT_PROVIDER, AGENT_MODEL,
#         AGENT_BASE_URL, and AGENT_API_KEY. Real mode FAILS LOUDLY if any of these
#         are missing; it never silently falls back to mock output, because
#         presenting canned text as though a real model produced it would destroy
#         the audit value of the pipeline.
AGENT_MODE=mock

# ---------------------------------------------------------------------------
# Provider: "mock" or "openai_compatible"
# ---------------------------------------------------------------------------
AGENT_PROVIDER=mock

# ---------------------------------------------------------------------------
# Real-mode settings. Ignored entirely in mock mode.
# ---------------------------------------------------------------------------
# The model identifier to request.
# AGENT_MODEL=

# OpenAI-compatible base URL, e.g. https://api.example.com/v1
# The provider is deliberately vendor-agnostic, so no vendor-specific default is
# assumed here.
# AGENT_BASE_URL=

# API key. Never logged, and never surfaced in API responses or health output.
# AGENT_API_KEY=

# Per-request timeout in seconds.
AGENT_TIMEOUT_SECONDS=20

# Sampling temperature. Advocates should be as reproducible as possible, so this
# defaults to 0.
AGENT_TEMPERATURE=0.0
