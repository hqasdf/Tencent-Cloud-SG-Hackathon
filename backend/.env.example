# Backend-only credentials. Never put them in Vite/frontend .env files.
#
# Provider priority (auto-detected at startup):
#   1. Google Gemini (if GEMINI_API_KEY is set) — free, no credit card
#   2. OpenAI (if OPENAI_API_KEY is set)
#   3. Tencent Hunyuan (if TENCENT_TOKENHUB_API_KEY is set)
#
# Option A: Google Gemini (recommended — free, no card, generous free tier)
#   Get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
#
# Option B: OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# Option C: Tencent Hunyuan via TokenHub (Singapore)
TENCENT_TOKENHUB_API_KEY=
TENCENT_TOKENHUB_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/plan/v3
TENCENT_MODEL=hunyuan-turbos-latest
