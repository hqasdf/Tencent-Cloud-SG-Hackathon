# Backend-only configuration. Copy to backend/.env for local development.
# backend/.env is gitignored. Never put server credentials in Vite/frontend files.
APP_ENV=development
# Empty preserves localhost/127.0.0.1:5173-5180 development origins.
CORS_ALLOWED_ORIGINS=
# Empty retains backend/intake.db locally. Production requires absolute durable paths.
INTAKE_DB_PATH=

# Offline default. Deterministic analysis and mock resolution agents work without
# credentials. AI intake remains unavailable unless a compatible provider is
# explicitly injected by an offline test.
AGENT_MODE=mock
AGENT_PROVIDER=mock
AGENT_TIMEOUT_SECONDS=30
AGENT_TEMPERATURE=0.0
AGENT_MAX_TOKENS=1024
AGENT_MAX_RETRIES=0

# Google Gemini Developer API. GeminiNativeProvider is the authoritative Gemini
# transport and uses native structured-output validation. These AGENT_* settings
# are shared by intake, Advocates, Rebuttals, and Judge. Set AGENT_MODEL to an
# actual model available to your account; the application has no fallback list.
# Never reuse an exposed credential.
#
# AGENT_MODE=real
# AGENT_PROVIDER=gemini_native
# AGENT_MODEL=gemini-3.8-flash
# AGENT_API_KEY=
# AGENT_TIMEOUT_SECONDS=30
# AGENT_TEMPERATURE=0
# AGENT_MAX_TOKENS=4096
# AGENT_MAX_RETRIES=1
# AGENT_RETRY_BACKOFF_SECONDS=1
# AGENT_RETRY_MAX_BACKOFF_SECONDS=20
# AGENT_REASONING_EFFORT=low

# Tencent TokenHub. Its Singapore base URL is built into the provider, so
# AGENT_BASE_URL may be omitted. AGENT_API_KEY is authoritative;
# TENCENT_TOKENHUB_API_KEY is supported only as a documented TokenHub fallback.
#
# AGENT_MODE=real
# AGENT_PROVIDER=tencent_tokenhub
# AGENT_MODEL=
# AGENT_API_KEY=
# TENCENT_TOKENHUB_API_KEY=

# Generic OpenAI-compatible service. A base URL is required. For a local service
# that does not authenticate, use a non-secret placeholder required by the
# provider contract.
#
# AGENT_MODE=real
# AGENT_PROVIDER=openai_compatible
# AGENT_BASE_URL=http://127.0.0.1:11434/v1
# AGENT_MODEL=
# AGENT_API_KEY=local-placeholder
# AGENT_TIMEOUT_SECONDS=30
# AGENT_MAX_TOKENS=1024

# Use the diagnostics command to inspect a configured provider without exposing
# its credential:
#   python -m app.agents.providers.diagnostics --list
