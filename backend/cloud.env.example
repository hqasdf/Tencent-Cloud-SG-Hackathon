# Backend project only. Set actual values privately in Vercel; never in VITE_*.
APP_ENV=production
STORAGE_BACKEND=turso
STORAGE_NAMESPACE=ryderesolve
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
CHECKPOINT_SIGNING_SECRET=
DEMO_SESSION_SECRET=
DEMO_PASSWORD_HASH=
CORS_ALLOWED_ORIGINS=https://ryderesolve.vercel.app
AGENT_MODE=mock
AGENT_PROVIDER=mock
AGENT_MAX_TOKENS=1024
AGENT_MAX_RETRIES=0
REPLAY_API_ENABLED=1
# No AGENT_API_KEY is needed in the default mock release.
# Live preview requires separate approval and backend-only configuration.
# Keep these disabled until approval and free-tier confirmation.
CLOUD_LIVE_AI_ENABLED=0
GEMINI_FREE_TIER_CONFIRMED=0
# CLOUD_GEMINI_DAILY_ATTEMPTS=20
# CLOUD_GEMINI_CUMULATIVE_ATTEMPTS=20
# AGENT_MODEL=gemini-3.5-flash-lite
# AGENT_MAX_TOKENS=4096
# AGENT_TIMEOUT_SECONDS=60
# CLOUD_GEMINI_DAILY_TOKEN_BUDGET=1000000
# AGENT_API_KEY= (set privately only after approval; never VITE_*)

# Explicit release gate; leave disabled until production release is approved.
CLOUD_PRODUCTION_APPROVED=0
# For live production, supply the existing shared usage/cooldown namespace.
# CLOUD_GEMINI_USAGE_NAMESPACE=<approved-existing-ledger-namespace>
